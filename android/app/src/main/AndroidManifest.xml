<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.rkkvishva.nothing_dialer">

    <!-- ─── Permissions ─── -->
    <!-- Noto multilingual font download (google_fonts) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to use InCallService as Default Dialer -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Read call state/log for monitoring outgoing calls -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Place phone calls from the dial pad -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Read phone state (fallback monitoring) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Keep CPU alive while call is in progress -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service for background InCallService resilience -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Bluetooth audio routing (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Read phone contacts for Contacts tab -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Show ongoing call notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Incoming call: full-screen UI over keyguard (OS typically fires when locked) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:label="Nothing Dialer"
        android:icon="@mipmap/launcher_icon_default"
        android:roundIcon="@mipmap/launcher_icon_default"
        android:name="${applicationName}">

        <!-- Nothing Glyph API Key: defaults to "test"; set nothing.glyph.key in android/local.properties -->
        <meta-data
            android:name="NothingKey"
            tools:replace="android:value"
            android:value="${nothingGlyphKey}" />

        <activity
            android:name="com.rkkvishva.nothing_dialer.MainActivity"
            android:exported="true"
            android:icon="@mipmap/launcher_icon_default"
            android:roundIcon="@mipmap/launcher_icon_default"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- MAIN/LAUNCHER on MainActivity: required for `flutter run` (tool reads src/main only).
                 Release removes this filter; launcher is activity-alias only (see src/release). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Required for Default Dialer role -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- Assistant / Gemini: outbound calls via CREATE_CALL App Action -->
            <intent-filter>
                <action android:name="android.intent.action.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Launcher icons: exactly one alias enabled at a time (see LauncherIconManager). -->
        <activity-alias
            android:name=".LauncherAliasDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/launcher_icon_default"
            android:roundIcon="@mipmap/launcher_icon_default"
            android:label="Nothing Dialer">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAliasLight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_light"
            android:roundIcon="@mipmap/launcher_icon_light"
            android:label="Nothing Dialer">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAliasRed"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_red"
            android:roundIcon="@mipmap/launcher_icon_red"
            android:label="Nothing Dialer">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAliasGrey"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_grey"
            android:roundIcon="@mipmap/launcher_icon_grey"
            android:label="Nothing Dialer">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAliasCream"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_cream"
            android:roundIcon="@mipmap/launcher_icon_cream"
            android:label="Nothing Dialer">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAliasOldPhone"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_old_phone"
            android:roundIcon="@mipmap/launcher_icon_old_phone"
            android:label="Nothing Dialer">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAliasOldPhoneLight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/launcher_icon_old_phone_light"
            android:roundIcon="@mipmap/launcher_icon_old_phone_light"
            android:label="Nothing Dialer">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ─── In-Call Screen (native Kotlin) ─── -->
        <!-- Required because IN_CALL_SERVICE_UI=true means WE provide the call UI. -->
        <activity
            android:name=".InCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=".InCall"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- ─── Glyph InCallService ─── -->
        <!-- This service is granted access to Call.State.DIALING vs ACTIVE
             only because the app is registered as the Default Dialer. -->
        <service
            android:name=".GlyphInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true"
            android:foregroundServiceType="phoneCall">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <!-- Marks this as a full in-call UI replacement -->
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
        </service>

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".MissedCallReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Flutter embedding meta-data -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <!-- Voice search: let the app see the system speech recognizer -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.action.WEB_SEARCH" />
        </intent>
    </queries>
</manifest>
